# Copy to .env.local for local development. Never commit real values.
DEEPGRAM_API_KEY=
# Long passphrase, at least access_gate.min_code_length characters. Only used to set up the first passkey.
LISTENER_ACCESS_CODE=
# 32 random bytes, base64. Encrypts every client's data key. Losing it makes stored data unreadable.
LISTENER_MASTER_KEY=
# Postgres connection as the listener_app role (see db/migrations/0001_init.sql).
DATABASE_URL=
# Optional but recommended: the database host's CA certificate (PEM). With it, the server
# checks it is talking to the real database, not just that the line is encrypted.
# Supabase: Project Settings > Database > SSL Configuration > Download certificate.
DATABASE_CA_CERT=
# Random string, at least 16 characters. Vercel Cron sends it to the purge route.
CRON_SECRET=
# Optional: pin passkeys to one address, e.g. https://listener-yourname.vercel.app
LISTENER_ORIGIN=
# Anthropic API key for summaries (console.anthropic.com).
ANTHROPIC_API_KEY=
